# ══ Addresses ══
# The product lives at https://castlingtrader.com/tradingmath/ . The old address trademath.in sends everyone there.
# Both domains point at this one folder, so the files exist once and these rules decide what each domain shows.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # certificate checks and robots.txt are never redirected
  RewriteRule ^(\.well-known/.*|robots\.txt)$ - [L]

  # www.<domain> goes to <domain>
  RewriteCond %{HTTP_HOST} ^www\.(trademath\.in|castlingtrader\.com)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # ── Old address: trademath.in ──
  # Fallback: if copying a visitor's saved journal to the new address ever fails, they keep the old site working (cookie set by move.js).
  RewriteCond %{HTTP_HOST} ^trademath\.in$ [NC]
  RewriteCond %{HTTP_COOKIE} (^|;\s*)tm_stay=1
  RewriteRule ^ - [L]
  # the small "moving your journal" page and its files
  RewriteCond %{HTTP_HOST} ^trademath\.in$ [NC]
  RewriteRule ^(move\.html|move\.js|logo-icon\.svg|favicon-32\.png|api/.*)$ - [L]
  # the app itself: a visitor whose journal has not been copied yet goes through move.html first (it copies, then redirects)
  RewriteCond %{HTTP_HOST} ^trademath\.in$ [NC]
  RewriteCond %{HTTP_COOKIE} !(^|;\s*)tm_moved=1
  RewriteCond %{HTTP_USER_AGENT} !(bot|crawl|spider|slurp|facebookexternalhit|embedly|preview|lighthouse|validator) [NC]
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteRule ^(index\.html)?$ move.html [L]
  # the journal template was renamed with the product
  RewriteCond %{HTTP_HOST} ^trademath\.in$ [NC]
  RewriteRule ^trademath-trading-journal-template\.csv$ https://castlingtrader.com/tradingmath/tradingmath-trading-journal-template.csv [R=301,L]
  # everything else (search engines, guide pages, visitors already moved): permanent redirect to the same page at the new address
  RewriteCond %{HTTP_HOST} ^trademath\.in$ [NC]
  RewriteRule ^(index\.html)?$ https://castlingtrader.com/tradingmath/ [R=301,L]
  RewriteCond %{HTTP_HOST} ^trademath\.in$ [NC]
  RewriteRule ^(.+)$ https://castlingtrader.com/tradingmath/$1 [R=301,L]

  # ── New address: castlingtrader.com ──
  RewriteCond %{HTTP_HOST} ^castlingtrader\.com$ [NC]
  RewriteRule ^$ /tradingmath/ [R=302,L]
  RewriteCond %{HTTP_HOST} ^castlingtrader\.com$ [NC]
  RewriteRule ^tradingmath/index\.html$ /tradingmath/ [R=301,L]
  RewriteCond %{HTTP_HOST} ^castlingtrader\.com$ [NC]
  RewriteRule ^tradingmath/(journal|planner|settings|profile)/$ /tradingmath/$1 [R=301,L]
  RewriteCond %{HTTP_HOST} ^castlingtrader\.com$ [NC]
  RewriteRule ^tradingmath/(journal|planner|settings|profile)$ index.html [L]
  RewriteCond %{HTTP_HOST} ^castlingtrader\.com$ [NC]
  RewriteRule ^tradingmath/$ index.html [L]
  RewriteCond %{HTTP_HOST} ^castlingtrader\.com$ [NC]
  RewriteRule ^tradingmath/us$ /tradingmath/us/ [R=301,L]
  RewriteCond %{HTTP_HOST} ^castlingtrader\.com$ [NC]
  RewriteRule ^tradingmath/(.+)$ $1 [L]
  # a request for anything outside the folder (the original request line is checked, so the rewrites above are not caught) goes inside it
  RewriteCond %{HTTP_HOST} ^castlingtrader\.com$ [NC]
  RewriteCond %{THE_REQUEST} \s/(?!tradingmath(?:/|\s|\?))
  RewriteRule ^(.+)$ /tradingmath/$1 [R=301,L]
</IfModule>

# ── Markdown copy of the home page for agents (served as a normal file; the home page points to it) ──
AddType "text/markdown; charset=UTF-8" .md
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Link '</llms.txt>; rel="describedby"; type="text/plain", </index.md>; rel="alternate"; type="text/markdown"'
  </FilesMatch>
  <FilesMatch "^index\.md$">
    Header set Link '<https://castlingtrader.com/tradingmath/>; rel="canonical"'
    Header set X-Robots-Tag "noindex"
  </FilesMatch>
</IfModule>

# ── Friendly 404 page ──
ErrorDocument 404 /404.html

# ── Developer notes and version-control files are not part of the site ──
<FilesMatch "^(CLAUDE|GEMINI_PROMPT)\.md$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git

# ── Security headers ──
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set Strict-Transport-Security "max-age=31536000"
  # Only our own files may run or load, plus Google's sign-in button. Nothing can be sent to other sites.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>

# ── Speed: pages are always re-checked (cheap 304 when unchanged); scripts, styles and fonts carry a version stamp
#    in their address (see tools/stamp_assets.py), so they can be kept for a year. ──
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|svg|ico|xml|txt)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
